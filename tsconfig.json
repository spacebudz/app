{
  "include": ["./src/**/*", "src/custom.d.ts"],
  "compilerOptions": {
    "target": "esnext" /* or at least ES2015 */,
    "module": "esnext" /* or at least ES2015 */,
    "lib": ["dom", "esnext"] /* <-- required! */,
    "jsx": "react" /* <-- required! */,
    "moduleResolution": "node" /* <-- required! */,
    "esModuleInterop": true,
    "skipLibCheck": true,

    /* for mixed ts/js codebase */
    "allowJs": true,
    "outDir": "./build" /* this won't be used by ts-loader */,

    /* the real types of this lib need a newer TS than 4.5, see the stub */
    "paths": {
      "@lucid-evolution/lucid": ["./src/types/lucid-evolution.d.ts"]
    }
    /* other options... */
  }
}
